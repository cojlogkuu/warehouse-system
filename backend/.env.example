# HTTP port the API listens on
PORT=3000
# Origin allowed by CORS (the Vite dev server)
CORS_ORIGIN=http://localhost:5173
# Connection string of the local PostgreSQL container (see docker-compose.yml)
DATABASE_URL=postgresql://warehouse:warehouse@localhost:5432/warehouse?schema=public

# Authentication. The two secrets have no default, need at least 32 characters and must differ.
# Generate each of them separately:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Lifetimes in seconds: 15 minutes and 7 days
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Send the refresh cookie over HTTPS only. false for local HTTP, true everywhere else
COOKIE_SECURE=false

# Local PostgreSQL container (docker-compose.yml). Every variable is optional, the values below
# are the defaults. If you change one of them, change DATABASE_URL above as well.
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse
POSTGRES_DB=warehouse
POSTGRES_PORT=5432

# First administrator, read only by `yarn db:seed` (not by the application)
SEED_ADMIN_EMAIL=admin@example.com
# At least 12 characters, at most 72 bytes
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=System Administrator
